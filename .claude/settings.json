{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "VOICE_SERVER_HTTP_PORT": "5555",
    "VOICE_SERVER_START_BY_DEFAULT": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings"
    ],
    "defaultMode": "bypassPermissions",
    "disableAutoMode": "disable"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "disableArtifact": false,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "typescript-hooks@goodfoot": true,
    "typescript-claude-code-for-web-setup@goodfoot": false,
    "project@goodfoot": false,
    "vscode@goodfoot": true,
    "goodfoot@goodfoot": true,
    "jsdoczoom@goodfoot": true,
    "code-simplifier@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "claude-code-hooks@goodfoot": true,
    "git-span@git-span": true,
    "agent-hooks@goodfoot": true,
    "agent-sklls@goodfoot": true,
    "wiki@goodfoot-wiki": true,
    "mattpocock-skills@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "git-span": {
      "source": {
        "source": "directory",
        "path": "/workspace"
      }
    },
    "goodfoot": {
      "source": {
        "source": "github",
        "repo": "goodfoot-io/marketplace"
      }
    },
    "goodfoot-wiki": {
      "source": {
        "source": "github",
        "repo": "goodfoot-io/wiki"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "askUserQuestionTimeout": "never"
}
