{
  "name": "@goodfoot/git-span-monorepo",
  "version": "1.1.45",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/git-span.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "npm/*"
    ]
  },
  "scripts": {
    "reset": "find . -type d -name node_modules | xargs rm -rf && rm -rf yarn.lock",
    "knip": "knip --config ./knip.config.json",
    "knip:fix": "knip --fix --config ./knip.config.json",
    "lint": "yarn workspaces foreach --parallel -A run lint && yarn lint:root",
    "lint:root": "biome ci --error-on-warnings --max-diagnostics 500 ./scripts ./.claude/skills ./.codex/skills ./packages/git-span/scripts ./plugins-opencode/git-span/bin",
    "lint:fix": "yarn workspaces foreach --parallel -A run lint:fix && yarn lint:root:fix",
    "lint:root:fix": "biome check --write ./scripts ./.claude/skills ./.codex/skills ./packages/git-span/scripts ./plugins-opencode/git-span/bin",
    "test": "turbo run test:uncached --concurrency=1",
    "typecheck": "bash scripts/typecheck.sh",
    "build": "node scripts/ensure-worktree-local-generated.mjs --all && yarn workspaces foreach -At run build",
    "watch": "yarn workspaces foreach -Api run watch",
    "build:debug": "yarn workspaces foreach -A run build:debug",
    "clean:tsbuildinfo": "find . \\( -name 'tsconfig.tsbuildinfo' \\) -not -path '*/node_modules/*' -not -path '*/.worktrees/*' -delete",
    "build:migration": "node scripts/ensure-worktree-local-generated.mjs scripts && node scripts/build-migration.mjs",
    "dev": "yarn workspace @goodfoot/git-span-website run dev",
    "dev:stop": "yarn workspace @goodfoot/git-span-website run dev:stop",
    "build:agent-skills": "node scripts/build-agent-skills.mjs",
    "lint:agent-skills": "node scripts/lint-agent-skills.mjs",
    "validate": "bash scripts/validate.sh",
    "bump": "bash scripts/bump.sh",
    "release": "bash scripts/release.sh",
    "test:skip-cache": "DISABLE_TEST_CACHE=true turbo run test:uncached --force --concurrency=1"
  },
  "private": true,
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@goodfoot/agent-skills": "1.0.28",
    "@types/node": "24.x",
    "esbuild": "^0.28.2",
    "knip": "^6.32.2",
    "rkyv-js": "^0.3.0",
    "turbo": "2.11.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "puppeteer-core": "^25.7.0"
  },
  "resolutions": {
    "@effect/platform-node-shared": "4.0.1"
  }
}
