{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "trailingCommas": "none",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "useIterableCallbackReturn": "error",
        "noImplicitAnyLet": "error",
        "noAssignInExpressions": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":PACKAGE:", ["@goodfoot/**"], ":PATH:"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/target",
      "!!**/coverage",
      "!!**/.next",
      "!!**/.cache",
      "!!**/*.log",
      "!!plugins-claude/git-span/hooks/bin/**/*.mjs",
      "!!plugins-codex/git-span/hooks/*.mjs",
      "!!plugins-antigravity/git-span/bin/**/*.mjs",
      "!!skills-src",
      "!!plugins-claude/git-span/skills",
      "!!plugins-codex/git-span/skills",
      "!!plugins-opencode/git-span/skills",
      "!!plugins-antigravity/git-span/skills"
    ]
  }
}
