{
  "name": "git-span-extension",
  "displayName": "Git Span",
  "description": "Exposes the Git Span CLI in VS Code.",
  "version": "1.1.9",
  "publisher": "goodfoot",
  "type": "module",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/bundle.cjs",
  "contributes": {
    "commands": [
      {
        "command": "gitSpan.showVersion",
        "title": "Show CLI Version",
        "category": "Git Span"
      },
      {
        "command": "gitSpan.openTerminal",
        "title": "Open Terminal",
        "category": "Git Span"
      }
    ],
    "customEditors": [
      {
        "viewType": "gitSpan.spanFileViewer",
        "displayName": "Git Span Anchor Diff",
        "selector": [
          {
            "filenamePattern": "**/.span/**"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ../../scripts/ensure-worktree-local-generated.mjs packages/extension && node scripts/build/build-production.js",
    "build": "node ../../scripts/ensure-worktree-local-generated.mjs packages/extension && vsce package --no-dependencies --follow-symlinks && { [ -n \"${SKIP_INSTALL:-}\" ] || bash scripts/install-vsix.sh; }",
    "build:testing": "node ../../scripts/ensure-worktree-local-generated.mjs packages/extension && node scripts/build/build-testing.js",
    "test": "node ../../scripts/ensure-worktree-local-generated.mjs packages/extension && node --import tsx test/runTest.ts",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./test ./scripts && jsdoczoom -l",
    "typecheck": "node ../../scripts/ensure-worktree-local-generated.mjs packages/extension && tsgo --noEmit",
    "clean": "rm -rf dist out dist-test-* *.vsix tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.101.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "jsdoczoom": "^1.2.6",
    "mocha": "^11.8.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goodfoot-io/git-span"
  },
  "author": {
    "name": "Goodfoot Media LLC",
    "url": "https://goodfoot.io"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "0.0.46-24",
    "monaco-editor": "^0.56.0"
  }
}
