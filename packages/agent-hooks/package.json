{
  "name": "agent-hooks",
  "version": "1.1.14",
  "type": "module",
  "scripts": {
    "build": "yarn build:claude && yarn build:codex && yarn build:mswea",
    "build:claude": "yarn build:hooks",
    "build:codex": "yarn build:hooks:codex",
    "build:mswea": "yarn build:hooks:mswea",
    "build:hooks": "yarn claude-code-hooks -i \"src/claude/{session-start,advisor,static-plan,post-tool-use,post-tool-use-failure,session-end}.ts\" -o \"../../plugins-claude/git-span/hooks/hooks.json\" --no-sourcemap",
    "build:hooks:codex": "yarn codex-hooks -i \"src/codex/{session-start,advisor,static-plan,apply-patch-plan,post-tool-use,stop}.ts\" -o \"../../plugins-codex/git-span/hooks/hooks.json\" --plugin-root --no-sourcemap",
    "build:hooks:mswea": "yarn claude-code-hooks -i \"src/mswea/{advisor,static-plan,post-tool-use,post-tool-use-failure,session-end}.ts\" -o \"../../packages/mini-swe-agent/src/minisweagent_gitspan/hooks/hooks.json\"",
    "claude-code-hooks": "node scripts/hooks-cli-wrapper.js @goodfoot/claude-code-hooks",
    "codex-hooks": "node scripts/hooks-cli-wrapper.js @goodfoot/codex-hooks",
    "bench:static": "node scripts/run-static-attribution-benchmark.js",
    "bench:hooks": "node scripts/run-hook-path-benchmark.js",
    "bench:context-hooks": "node scripts/run-context-integration-benchmark.js",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goodfoot/claude-code-hooks": "^1.9.0",
    "@goodfoot/codex-hooks": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "24.x",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
