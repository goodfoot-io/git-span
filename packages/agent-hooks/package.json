{
  "name": "agent-hooks",
  "version": "1.1.37",
  "type": "module",
  "scripts": {
    "build": "yarn build:claude && yarn build:codex && yarn build:opencode && yarn build:antigravity",
    "build:claude": "yarn build:hooks",
    "build:codex": "yarn build:hooks:codex",
    "build:antigravity": "yarn agent-hooks --agent antigravity -i \"src/antigravity/{pre-invocation,static-plan,tool-call-stash,post-tool-use,post-invocation,stop}.ts\" -o \"../../plugins-antigravity/git-span/hooks.json\" --no-sourcemap",
    "build:opencode": "yarn agent-hooks --agent opencode -i \"src/opencode/index.ts\" -o \"../../plugins-opencode/git-span/dist\" --no-sourcemap",
    "build:hooks": "yarn agent-hooks --agent claude-code -i \"src/claude/{session-start,static-plan,post-tool-use,post-tool-use-failure,stop,session-end}.ts\" -o \"../../plugins-claude/git-span/hooks/hooks.json\" --no-sourcemap",
    "build:hooks:codex": "yarn agent-hooks --agent codex -i \"src/codex/{session-start,static-plan,apply-patch-plan,post-tool-use,stop}.ts\" -o \"../../plugins-codex/git-span/hooks/hooks.json\" --plugin-root --no-sourcemap",
    "agent-hooks": "node scripts/hooks-cli-wrapper.js",
    "bench:static": "node scripts/run-static-attribution-benchmark.js",
    "bench:hooks": "node scripts/run-hook-path-benchmark.js",
    "bench:context-hooks": "node scripts/run-context-integration-benchmark.js",
    "test": "yarn run -T turbo run test:uncached --filter=agent-hooks --cwd \"$PROJECT_CWD\" --",
    "lint": "biome ci --error-on-warnings --max-diagnostics 500 .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:uncached": "vitest run"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "1.0.14",
    "acorn": "8.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@goodfoot/vitest-cache": "1.0.5",
    "@opencode/plugin": "2.1.2",
    "@types/node": "24.x",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
