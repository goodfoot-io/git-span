{
  "name": "agent-hooks",
  "version": "1.1.20",
  "type": "module",
  "scripts": {
    "build": "yarn build:claude && yarn build:codex && yarn build:opencode",
    "build:claude": "yarn build:hooks",
    "build:codex": "yarn build:hooks:codex",
    "build:opencode": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/opencode/index.ts'], absWorkingDir: process.cwd(), bundle: true, platform: 'node', format: 'esm', minify: false, sourcemap: false, outfile: '../../plugins-opencode/git-span/dist/index.js' })\"",
    "build:hooks": "yarn agent-hooks --agent claude-code -i \"src/claude/{session-start,advisor,static-plan,post-tool-use,post-tool-use-failure,session-end}.ts\" -o \"../../plugins-claude/git-span/hooks/hooks.json\" --no-sourcemap",
    "build:hooks:codex": "yarn agent-hooks --agent codex -i \"src/codex/{session-start,advisor,static-plan,apply-patch-plan,post-tool-use,stop}.ts\" -o \"../../plugins-codex/git-span/hooks/hooks.json\" --plugin-root --no-sourcemap",
    "agent-hooks": "node scripts/hooks-cli-wrapper.js",
    "bench:static": "node scripts/run-static-attribution-benchmark.js",
    "bench:hooks": "node scripts/run-hook-path-benchmark.js",
    "bench:context-hooks": "node scripts/run-context-integration-benchmark.js",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "24.x",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
