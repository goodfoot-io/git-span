{
  "name": "@goodfoot/git-span-website",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-worktree-local-generated.mjs packages/website && node scripts/dev-with-tunnel.mjs",
    "dev:stop": "node scripts/dev-with-tunnel.mjs stop",
    "dev:vite": "node ../../scripts/ensure-worktree-local-generated.mjs packages/website && react-router dev",
    "build": "node ../../scripts/ensure-worktree-local-generated.mjs packages/website && react-router build",
    "generate:images": "node scripts/generate-metadata-images.mjs",
    "deploy": "yarn build && wrangler deploy",
    "lint": "biome check --write --unsafe --max-diagnostics 500",
    "fumadocs:generate": "node ../../scripts/ensure-worktree-local-generated.mjs packages/website && fumadocs-mdx",
    "typecheck": "yarn fumadocs:generate && react-router typegen && tsc --noEmit",
    "test": "node ../../scripts/ensure-worktree-local-generated.mjs packages/website && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "fumadocs-core": "^16.14.4",
    "fumadocs-ui": "^16.14.4",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "fumadocs-mdx": "^15.2.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
